# Puerto HTTP para el servidor Express
PORT=3000

# Token de verificación configurado en Meta para validar el webhook
META_VERIFY_TOKEN=pon-aqui-tu-token-de-verificacion

# Token de acceso y número de teléfono de la WhatsApp Cloud API
META_ACCESS_TOKEN=pon-aqui-tu-token-de-acceso
META_PHONE_NUMBER_ID=pon-aqui-tu-numero-de-telefono

# Clave de API para el modelo de lenguaje
OPENAI_API_KEY=pon-aqui-tu-api-key
